---
interface Props {
  date: Date;
}

const { date } = Astro.props;
const isRealDate = date instanceof Date && !isNaN(date.valueOf());
---

{
  isRealDate ? (
    <time datetime={(date as Date).toISOString()}>
      {(date as Date).toLocaleDateString("en-us", {
        year: "numeric",
        month: "short",
        day: "numeric",
      })}
    </time>
  ) : (
    <span class="coming-soon-badge">{date}</span>
  )
}
