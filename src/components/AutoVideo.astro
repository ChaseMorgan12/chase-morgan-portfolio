---
const { videoSrc, fallbackImage, height = 400 } = Astro.props;

const inlineStyle = `height: ${height};`;
---

<div class="video-container" style={inlineStyle}>
  <video
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster={fallbackImage}
  >
    <source src={videoSrc} type="video/mp4" />
  </video>
  <div class="overlay-content">
    <slot />
  </div>
</div>

<style>
  .video-container {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  .video-container::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.4);
    z-index: 2;
  }
  video {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }
  .overlay-content {
    position: relative;
    z-index: 3;
    width: 100%;
    height: 100%;
  }
</style>
