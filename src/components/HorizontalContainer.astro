---
interface Props {
  align?: "left" | "center" | "right";
}

const { align = "center" } = Astro.props;

const alignmentMap = {
  left: "flex-start",
  center: "center",
  right: "flex-end",
};
---

<div
  class="horizontal-container"
  style={`--justify-align: ${alignmentMap[align]}`}
>
  <slot />
</div>

<style>
  .horizontal-container {
    display: flex;
    flex-direction: row;
    gap: 0.75rem;
    align-items: center;
    justify-content: var(--justify-align);
    margin: 1.5rem 0;
  }
</style>
